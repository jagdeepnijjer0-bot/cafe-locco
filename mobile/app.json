{
  "expo": {
    "name": "Cafe Locco",
    "slug": "cafe-locco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cafelocco",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.braxton.restaurant",
      "buildNumber": "1",
      "minimumOsVersion": "15.1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "Used to select a profile photo.",
        "NSPhotoLibraryAddOnlyUsageDescription": "Used to save photos to your library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.braxton.restaurant",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cafe Locco to access your photo library."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.braxton.restaurant",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "3aed1e5b-0e5b-4505-ad89-93295698b68f"
      },
      "router": {}
    },
    "owner": "jagdeepn"
  }
}
